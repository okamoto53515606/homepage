{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "set-admin": "tsx cli/set-admin.ts",
    "remove-admin": "tsx cli/remove-admin.ts",
    "check-admin": "tsx cli/check-admin.ts",
    "init-settings": "tsx cli/init-settings.ts",
    "cli:manage-tags": "tsx --tsconfig tsconfig.cli.json cli/manage-tags.ts",
    "migrate:firestore-to-dynamodb": "tsx cli/migration_firestore_to_dynamodb.ts"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.20.0",
    "@genkit-ai/next": "^1.20.0",
    "@next/third-parties": "^16.1.1",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^16.5.0",
    "firebase": "^11.0.2",
    "firebase-admin": "^13.6.0",
    "genkit": "^1.20.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.15",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "stripe": "^20.1.0",
    "tsx": "^4.16.2",
    "zod": "^3.24.2"
