    "@aws-sdk/client-secrets-manager": "^3.1032.0",
    "@aws-sdk/lib-dynamodb": "^3.1032.0",
    "@google-cloud/storage": "^7.19.0",
    "@types/node": "^20",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "aws-cdk": "^2.1118.2",
    "aws-cdk-lib": "^2.250.0",
    "constructs": "^10.6.0",
    "genkit-cli": "^1.20.0",
    "source-map-support": "^0.5.21",
